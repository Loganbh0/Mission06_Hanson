@model List<Mission06_Hanson.Models.Movie>

<div class="container mt-5">

    <div class="text-center mb-4">
        <h1 class="display-5 fw-bold">Joel Hilton Movie Collection</h1>
        <p class="text-muted">Complete inventory of the collection - Ordered alphabetically</p>
    </div>

    <div class="card shadow">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover table-bordered mb-0 align-middle">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>Title</th>
                            <th>Year</th>
                            <th>Category</th>
                            <th>Director</th>
                            <th>Rating</th>
                            <th>Edited</th>
                            <th>Copied to Plex</th>
                            <th>Lent To</th>
                            <th>Notes</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@m.Title</td>
                                <td>@m.Year</td>
                                <td>@(m.Category?.CategoryName ?? "")</td>
                                <td>@(m.Director ?? "")</td>
                                <td>@(m.Rating ?? "")</td>

                                <td class="text-center">
                                    @(m.Edited == true ? "Yes" : "No")
                                </td>

                                <td class="text-center">
                                    @(m.CopiedToPlex == true ? "Yes" : "No")
                                </td>

                                <td>@m.LentTo</td>
                                <td>@m.Notes</td>
                                <td class="text-center">
                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-controller="Movie"
                                       asp-action="Edit"
                                       asp-route-id="@m.MovieId">
                                        Edit
                                    </a>
                                    <br />
                                    <a class="btn btn-sm btn-outline-danger"
                                       asp-controller="Movie"
                                       asp-action="ConfirmDelete"
                                       asp-route-id="@m.MovieId">
                                        Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>