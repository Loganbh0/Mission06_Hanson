@{
    ViewData["Title"] = "Confirmation";
}

<div class="confetti-bg">
    <div class="container py-5">
        <div class="party-card mx-auto text-center p-4 p-md-5">

            <div class="badge-row mb-3">
                <span class="party-badge">✅ Saved</span>
                <span class="party-badge">🍿 Certified Cinema</span>
                <span class="party-badge">🎬 Mission 06 Energy</span>
            </div>

            <h1 class="party-title mb-2">
                @ViewBag.MovieTitle ADDED!
            </h1>
            <p class="party-subtitle mb-4">
                Your masterpiece has officially joined <span class="glow-text">The Joel Hilton Film Collection</span>.
            </p>

            <div class="d-flex gap-3 justify-content-center flex-wrap">
                <a asp-controller="Movie" asp-action="EnterMovie" class="btn btn-lg btn-party">
                    ➕ Add Another
                </a>
            </div>
        </div>
    </div>

    <!-- Confetti canvas -->
    <canvas id="confettiCanvas"></canvas>
</div>

<style>
    .confetti-bg{
        min-height: 100vh;
        background: radial-gradient(circle at 20% 20%, #ff00cc22 0%, transparent 40%),
                    radial-gradient(circle at 80% 10%, #00e5ff22 0%, transparent 40%),
                    radial-gradient(circle at 50% 90%, #ffe60022 0%, transparent 40%),
                    linear-gradient(135deg, #0b1020 0%, #111827 45%, #1f2937 100%);
        position: relative;
        overflow: hidden;
    }

    .party-card{
        max-width: 820px;
        border-radius: 24px;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.14);
        backdrop-filter: blur(10px);
        transform: translateY(10px);
        animation: popIn .6s ease-out forwards;
        box-shadow: 0 30px 80px rgba(0,0,0,.55);
    }

    .party-title{
        font-size: clamp(2.2rem, 4vw, 3.4rem);
        letter-spacing: .06em;
        font-weight: 800;
        color: #ffffff;
        text-shadow: 0 0 18px rgba(0,229,255,.25), 0 0 32px rgba(255,0,204,.18);
    }

    .party-subtitle{
        font-size: 1.1rem;
        color: rgba(255,255,255,.85);
    }

    .glow-text{
        color: #fff;
        text-shadow: 0 0 14px rgba(255,230,0,.25), 0 0 20px rgba(0,229,255,.18);
        font-weight: 700;
    }

    .badge-row{
        display:flex;
        gap: .5rem;
        justify-content:center;
        flex-wrap:wrap;
    }

    .party-badge{
        padding: .35rem .7rem;
        border-radius: 999px;
        font-size: .9rem;
        font-weight: 700;
        color: #0b1020;
        background: linear-gradient(90deg, #00e5ff, #ffe600, #ff00cc);
        box-shadow: 0 10px 30px rgba(0,0,0,.25);
    }

    .party-media{
        max-width: min(520px, 90%);
        border-radius: 18px;
        border: 1px solid rgba(255,255,255,.18);
    }

    .btn-party{
        color: #0b1020;
        font-weight: 800;
        border: none;
        background: linear-gradient(90deg, #00e5ff, #ffe600, #ff00cc);
        box-shadow: 0 16px 40px rgba(0,0,0,.35);
        transition: transform .15s ease, box-shadow .15s ease;
    }
    .btn-party:hover{
        transform: translateY(-2px) scale(1.02);
        box-shadow: 0 20px 50px rgba(0,0,0,.45);
    }

    .btn-outline-party{
        border: 2px solid rgba(0,229,255,.55);
        color: rgba(255,255,255,.92);
        background: transparent;
        font-weight: 700;
        transition: transform .15s ease, background .15s ease;
    }
    .btn-outline-party:hover{
        transform: translateY(-2px);
        background: rgba(0,229,255,.10);
        color: #fff;
    }

    #confettiCanvas{
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
    }
</style>

<script>
    // Tiny confetti engine (no libraries)
    (function () {
        const canvas = document.getElementById("confettiCanvas");
        const ctx = canvas.getContext("2d");

        function resize() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener("resize", resize);
        resize();

        const colors = ["#00e5ff", "#ffe600", "#ff00cc", "#7c3aed", "#22c55e", "#fb7185"];
        const confetti = [];
        const count = 180;

        function rand(min, max) { return Math.random() * (max - min) + min; }

        for (let i = 0; i < count; i++) {
            confetti.push({
                x: rand(0, canvas.width),
                y: rand(-canvas.height, 0),
                r: rand(2, 6),
                w: rand(6, 14),
                h: rand(8, 18),
                color: colors[(Math.random() * colors.length) | 0],
                vx: rand(-1.8, 1.8),
                vy: rand(2.5, 6.0),
                rot: rand(0, Math.PI),
                vr: rand(-0.12, 0.12)
            });
        }

        let start = performance.now();
        function tick(t) {
            const elapsed = t - start;
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            confetti.forEach(p => {
                p.x += p.vx;
                p.y += p.vy;
                p.rot += p.vr;

                if (p.y > canvas.height + 30) {
                    p.y = -30;
                    p.x = rand(0, canvas.width);
                }
                if (p.x < -30) p.x = canvas.width + 30;
                if (p.x > canvas.width + 30) p.x = -30;

                ctx.save();
                ctx.translate(p.x, p.y);
                ctx.rotate(p.rot);
                ctx.fillStyle = p.color;
                ctx.globalAlpha = 0.95;
                ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
                ctx.restore();
            });

            // Run hard for ~3 seconds, then chill (still looks alive)
            if (elapsed < 3000 || (elapsed < 12000 && (elapsed % 2 < 1))) {
                requestAnimationFrame(tick);
            }
        }

        requestAnimationFrame(tick);
    })();
</script>
